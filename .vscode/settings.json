{
    // ═══════════════════════════════════════════════════
    // HT9045 Insiders 高效率工作區設定
    // ═══════════════════════════════════════════════════

    // ── 搜尋與檔案排除：大幅加速全域搜尋 ──
    "search.exclude": {
        "**/.svn":       true,
        "**/Obj":        true,
        "**/EXE":        true,
        "**/hklib":      true,
        "**/MDB":        true,
        "**/backup":     true,
        "**/*.lib":      true,
        "**/*.dll":      true,
        "**/*.exe":      true,
        "**/*.res":      true,
        "**/*.obj":      true,
        "**/*.tds":      true,
        "**/*.bcc32pch": true,
        "**/*.mak":      true,
        "**/*.utf8bak":  true,
        "**/*.~cpp":     true,
        "**/*.~h":       true,
        "**/*.steven":   true,
        // 唯讀版本資料夾（僅保留 V899 目標版本可搜尋）
        "HT9011UC_Code_V3.33.893*": true,
        "HT9011UC_Code_V3.33.894*": true,
        "HT9011UC_Code_V3.33.895*": true,
        "HT9011UC_Code_V3.33.896*": true,
        "HT9011UC_Code_V3.33.897*": true,
        "HT9011UC_Code_V3.33.898*": true,
        "HT9011UC_Code_V3.33.899.0_20260323_Jimmy_20260409": true,
        "HT9011UC_Code_V3.33.901*": true,
        "HT9046LS_Code_*": true
    },
    "files.exclude": {
        "**/.svn":       true,
        "**/Obj":        true,
        "**/*.utf8bak":  true,
        "**/*.~cpp":     true,
        "**/*.~h":       true,
        "**/*.steven":   true,
        "**/*.bcc32pch": true,
        "**/*.tds":      true
    },
    "files.watcherExclude": {
        "**/.svn/**":  true,
        "**/Obj/**":   true,
        "**/EXE/**":   true,
        "**/hklib/**": true,
        "**/MDB/**":   true
    },

    // ── 編輯器效能：大型檔案友善 ──
    "editor.largeFileOptimizations": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.minimap.enabled": false,

    // ── C/C++ 檔案關聯 ──
    "files.associations": {
        "*.h":   "cpp",
        "*.cpp": "cpp",
        "*.dfm": "plaintext",
        "*.bpr": "xml",
        "*.inf": "ini",
        "*.dat": "plaintext"
    },

    // ── 搜尋增強 ──
    "search.smartCase": true,
    "search.showLineNumbers": true,
    "search.defaultViewMode": "tree",

    // ── 終端機 (PowerShell) ──
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.cwd": "${workspaceFolder}",
    // 註：BCB6 實際安裝在 D 槽（已用 bpr2mak.exe 實地確認）。
    //     舊值 C:\Program Files (x86)\Borland\CBuilder6 在本機不存在，
    //     會讓「BCB6: Build V899」工作因 ${env:BCB6} 指到空目錄而失敗。
    "terminal.integrated.env.windows": {
        "BCB6": "D:\\ProgramFiles\\Borland\\CBuilder6"
    },

    // ── Copilot / Chat（Insiders 加速項目）──
    "chat.agent.enabled": true,
    "github.copilot.chat.localeOverride": "zh-tw",

    // ── 檔案編碼（保持 BIG5 相容性）──
    "files.encoding": "big5",
    "files.autoGuessEncoding": true,

    // ── 保留原有 terminal autoApprove 設定 ──
    "chat.tools.terminal.autoApprove": {
        "ForEach-Object": true
    },

    // ═══════════════════════════════════════════════════
    // ⚠ Debug 攔中斷設定（鎖定，請勿關閉）
    // ───────────────────────────────────────────────────
    // 用途：確保 VS Code 偵錯時能停在中斷點 / 例外。
    // 註：VS Code 的「Raised / Uncaught Exceptions」勾選狀態
    //     存在 workspace storage，不在 settings.json，
    //     只能透過 Run and Debug → Breakpoints 面板勾選。
    //     若要每次都自動勾，必須寫進對應 launch.json 的設定中。
    // ═══════════════════════════════════════════════════
    "debug.allowBreakpointsEverywhere": true,        // 任何檔案都可下中斷點，請勿關閉
    "debug.showBreakpointsInOverviewRuler": true,    // 捲軸顯示中斷點
    "debug.showInlineBreakpointCandidates": true,    // 同行多點位顯示
    "debug.openDebug": "openOnDebugBreak",           // 中斷時自動切到 Debug View
    "debug.focusEditorOnBreak": true,                // 中斷時自動把游標跳到該行
    "debug.inlineValues": "auto",                    // 中斷時行內顯示變數值
    "debug.terminal.clearBeforeReusing": false,      // 中斷後保留終端內容方便追
    // Python 偵錯：Just My Code 關掉，才會在第三方/自家函式都能停
    "debugpy.debugJustMyCode": false
}