{
  // ==========================================================================
  //  V906 debug/run configurations. AI(W906-GateA-vscode) 20260804.
  //
  //  TWO DEBUGGERS, because this project has two toolchains:
  //    * the MFC exe is built by MSVC  -> cppvsdbg (Visual Studio debugger)
  //    * the 126 ctest binaries are built by MinGW g++ -> gdb
  //  Mixing them does not work: cppvsdbg cannot read DWARF, and gdb cannot
  //  read PDB. Pick the configuration that matches what you are launching.
  //
  //  The exe is a RELEASE build with /Zi (root CMakeLists, ht9045_app target),
  //  so breakpoints work but locals may be optimised away. We do NOT offer a
  //  Debug-CRT build: its asserts raise modal dialogs (KNOWLEDGE.md Gotcha 9).
  //
  //  WHICH ONE IS "THE APP"?  AI(W906-WebHMI-F5) 20260812: the product
  //  direction is web UI + C++ core, so the default F5 experience is the
  //  "Web HMI" COMPOUND at the bottom: it builds (MinGW), starts the publisher
  //  (tcp 8046) and wb_gateway (http+ws 8045), then opens the browser HMI. The
  //  MFC exe stays only as the Gate A translation-verification harness -- its
  //  placeholder window is expected.
  //
  //  AI(W906-SimPump) 20260813: the compound's publisher is now `wb_publish
  //  --pump`, which DRIVES the translated state machine so the screen moves. The
  //  big word reads "SIM RUN"/"SIM HALT" -- SIM because nothing in the translated
  //  tree can set SystemStart/fAllMotorHome, so this process forces them. Read the
  //  PUMP MODE block in WebBridgeTags.h before changing any of that.
  // ==========================================================================
  "version": "0.2.0",
  "configurations": [
    {
      // AI(W906-StateWin) 20260814: RENAMED, and the rename is deliberate.
      //
      // This entry used to be called "MFC Gate A skeleton (HT9045.exe,
      // verification harness)" and it opened a window that said nothing about a
      // machine. It now opens the MACHINE STATE MONITOR, which reads the loopback
      // tag feed and displays the live state word plus the engine cursors.
      //
      // Renaming it also fixes a real trap: VS Code remembers the selected debug
      // configuration in per-workspace storage that the repo cannot reach, so a
      // developer who had once picked the old entry kept getting the placeholder
      // no matter what this file said. Changing the name invalidates that stale
      // selection, which is the only mechanism available from inside the repo.
      //
      // No preLaunchTask on purpose -- launch this via the compound at the bottom,
      // which builds BOTH toolchains once. Same house pattern as the two web
      // halves below.
      "name": "HT9045.exe -- Machine State window (native)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build_msvc_ui/HT9045.exe",
      // --devpath is REQUIRED from the build dir: golden's WinMain
      // (HT9045.cpp:151-155) rejects any path outside D:\HT9045\EXE\, and that
      // check is faithfully translated. Without it you get the EXE Path Error
      // box (and, in --smoke mode, a BootLog line instead).
      //
      // --feed-host/--feed-port default to 127.0.0.1:8046, so this window follows
      // whichever publisher is on that port: V906's wb_publish today, the V899
      // production handler once its snapshot port lands. No rebuild to switch.
      "args": ["--devpath"],
      "cwd": "${workspaceFolder}/build_msvc_ui",
      "console": "integratedTerminal",
      "symbolSearchPath": "${workspaceFolder}/build_msvc_ui"
    },
    {
      // The old Gate A open/pump/close harness, still reachable. It is kept
      // because it verifies the MFC message loop with ZERO dependencies -- useful
      // precisely when the state window is the thing under suspicion.
      "name": "HT9045.exe -- Gate A placeholder (bare MFC harness)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build_msvc_ui/HT9045.exe",
      "args": ["--devpath", "--gatea-placeholder"],
      "cwd": "${workspaceFolder}/build_msvc_ui",
      "console": "integratedTerminal",
      "preLaunchTask": "V906: Build UI exe (MSVC/MFC)",
      "symbolSearchPath": "${workspaceFolder}/build_msvc_ui"
    },
    {
      "name": "Run HT9045.exe headless (smoke, 800ms)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build_msvc_ui/HT9045.exe",
      // Auto-closes and suppresses WER fault dialogs -- safe to run unattended.
      "args": ["--devpath", "--smoke", "800"],
      "cwd": "${workspaceFolder}/build_msvc_ui",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug one ctest binary (MinGW/gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/tests/${input:testExe}.exe",
      "args": [],
      "stopAtEntry": false,
      // Several suites read real config/DB files with paths relative to the
      // tree root, so run from there rather than from build/tests.
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
      "preLaunchTask": "V906: Build (MinGW, quick)",
      "setupCommands": [
        {
          "description": "Pretty-print STL containers",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug the headless control probe (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build_msvc_ui/ht9045_ctrl_probe.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build_msvc_ui",
      "console": "integratedTerminal"
    },
    {
      // Data half of the sidecar split: links the god-stack, publishes the
      // tag snapshot on tcp://127.0.0.1:8046. --dry is NOT optional on a dev
      // machine: LoadMachineConfig() WRITES the shared production
      // system\Gerneral.ini (common.cpp:89); --dry works on a scratch copy.
      // No preLaunchTask here -- launch via the "Web HMI" compound below,
      // which builds once for both halves.
      "name": "Web HMI: wb_publish --dry (data feed)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/wb_publish.exe",
      "args": ["--dry"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
      "externalConsole": false
    },
    {
      // AI(W906-SimPump) 20260813: the feed the F5 compound actually uses.
      // --pump DRIVES the translated spine (MainProc every 250 ms), so the browser
      // shows a live machine.state word and moving engine cursors instead of a
      // static config dump. It reads NO ini and writes NO ini, which makes it
      // strictly safer than the --dry config above as well as more useful: --dry
      // still calls LoadMachineConfig against a scratch COPY of the production
      // Gerneral.ini, while --pump does not open it at all.
      //
      // The word on screen reads "SIM RUN"/"SIM HALT". That prefix is load-bearing,
      // not decoration -- this process forces SystemStart/fAllMotorHome because
      // NOTHING in the translated tree can set them (see WebBridgeTags.h for the
      // reachability measurement). No machine is attached and none is sensed.
      "name": "Web HMI: wb_publish --pump (live spine feed)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/wb_publish.exe",
      "args": ["--pump"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
      "externalConsole": false
    },
    {
      // Web half: links ht9045_webbridge and NOTHING else from the machine
      // side -- it cannot read a motor or open an ini. Serves D:\HT9045\web
      // on http://127.0.0.1:8045 and reconnects to the publisher by itself,
      // so start order does not matter.
      "name": "Web HMI: wb_gateway (web server, no machine code)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/wb_gateway.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
      "externalConsole": false,
      // Opens the browser HMI as soon as the gateway prints its startup URL.
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)/",
        "uriFormat": "http://127.0.0.1:%s/?src=ws",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      // THE default F5 for this project (pick it once in the debug dropdown;
      // VS Code remembers). Publisher and gateway start together; the browser
      // shows "---" until the first frame arrives, which is the correct
      // rendering of "no data yet".
      // AI(W906-StateWin) 20260814: THIS is the F5. It now delivers all three
      // things in one keypress, which is what it was missing before:
      //   1. the C++ core COMPILES   -- "Build ALL" does MinGW libs then the MSVC exe
      //   2. a NATIVE window shows machine state  -- HT9045.exe, reading the feed
      //   3. the WEB view opens      -- gateway + browser via serverReadyAction
      // Renamed from "Web HMI (...)" because it is no longer web-only, and because
      // the rename invalidates any stale remembered selection (see the note on the
      // state-window configuration above).
      "name": "HT9045: build + state window + web  (THE F5)",
      "configurations": [
        // AI(W906-SimPump) 20260813: switched from the --dry feed to the --pump
        // feed. The --dry config is still in the list above if you want the
        // config-derived identity tags instead of a moving screen.
        "Web HMI: wb_publish --pump (live spine feed)",
        "Web HMI: wb_gateway (web server, no machine code)",
        "HT9045.exe -- Machine State window (native)"
      ],
      // Builds BOTH toolchains, sequentially. A single preLaunchTask is all a
      // launch config gets, which is why this composite task had to exist before
      // one F5 could produce both halves (tasks.json, "V906: Build ALL").
      "preLaunchTask": "V906: Build ALL (MinGW libs + MSVC exe)",
      "stopAll": true,
      "presentation": { "order": 1 }
    }
  ],
  "inputs": [
    {
      "id": "testExe",
      "type": "promptString",
      "description": "ctest binary name, WITHOUT .exe (e.g. test_ga2_c1_cinitial, test_w7_l2_ckernel, test_ga1_lastset)",
      "default": "test_ga2_c1_cinitial"
    }
  ]
}
