{
  // ==========================================================================
  //  V906 debug/run configurations.  AI(W906-GateA-vscode) 20260804.
  //
  //  AI(W906-DropMSVC) 20260817: REWRITTEN. Four MSVC/MFC configurations lived
  //  here and every one of them pointed at build_msvc_ui\HT9045.exe, which
  //  commit 7b86cfd deleted along with the MFC UI. Pressing F5 therefore failed
  //  with "Invalid 'cwd' value 'D:\HT9045\HT9011UC_Cpp_V3.33.906.0/
  //  build_msvc_ui'". That was a wiring miss in that commit, not a build
  //  problem -- the removal itself was gate-verified.
  //
  //  ONE TOOLCHAIN NOW. MSVC left the product with the MFC UI, so every
  //  configuration below is MinGW + gdb (cppdbg). There is no cppvsdbg entry
  //  and there should never be another one unless MFC comes back.
  //
  //  THE DEBUGGER IS NEW, THE COMPILER IS NOT. miDebuggerPath points at gdb
  //  17.2 from install/mingw32-16.2.0 (see install/README.md). The compiler
  //  stays MinGW.org g++ 6.3.0 at C:\MinGW -- it is the only toolchain that
  //  reproduces BCB6's x87 arithmetic and build.bat has a FATAL guard on it.
  //  Reading DWARF is independent of generating code; verified 20260817 by
  //  breaking inside a g++ 6.3 -g binary under gdb 17.2 with working STL
  //  pretty-printers.
  //
  //  BREAKPOINTS NEED -g, WHICH build\ DOES NOT HAVE. CMAKE_BUILD_TYPE is empty
  //  there, so CXX_FLAGS is just -std=c++1z and nothing binds. For source-level
  //  debugging configure a SEPARATE dir -- keep build\ byte-comparable with
  //  every recorded baseline:
  //      cmake -S . -B build_dbg -G "MinGW Makefiles" -DCMAKE_BUILD_TYPE=Debug
  //      cmake --build build_dbg -j
  //  Debug means -g only (GCC defaults to -O0), so codegen matches build\.
  //  Do NOT use Release or RelWithDebInfo: -O3 is known to break MyPLCModbus
  //  and BarCodeBottom2DID (CMakeLists.txt:411-424 has the evidence).
  //
  //  AI(W906-SimPump) 20260813: the compound's publisher is `wb_publish --pump`,
  //  which DRIVES the translated state machine so the screen moves. The big word
  //  reads "SIM RUN"/"SIM HALT" -- SIM because nothing in the translated tree can
  //  set SystemStart/fAllMotorHome, so this process forces them. Read the PUMP
  //  MODE block in WebBridgeTags.h before changing any of that.
  // ==========================================================================
  "version": "0.2.0",
  "configurations": [
    {
      // AI(W906-SimPump) 20260813: the feed the F5 compound actually uses.
      // --pump DRIVES the translated spine (MainProc every 250 ms), so the browser
      // shows a live machine.state word and moving engine cursors instead of a
      // static config dump. It reads NO ini and writes NO ini, which makes it
      // strictly safer than the --dry config below as well as more useful: --dry
      // still calls LoadMachineConfig against a scratch COPY of the production
      // Gerneral.ini, while --pump does not open it at all.
      //
      // The word on screen reads "SIM RUN"/"SIM HALT". That prefix is load-bearing,
      // not decoration -- this process forces SystemStart/fAllMotorHome because
      // NOTHING in the translated tree can set them (see WebBridgeTags.h for the
      // reachability measurement). No machine is attached and none is sensed.
      "name": "Web HMI: wb_publish --pump (live spine feed)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/wb_publish.exe",
      "args": ["--pump"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/install/mingw32-16.2.0/mingw32/bin/gdb.exe",
      "externalConsole": false
    },
    {
      // Web half: links ht9045_webbridge and NOTHING else from the machine
      // side -- it cannot read a motor or open an ini. Serves D:\HT9045\web
      // on http://127.0.0.1:8045 and reconnects to the publisher by itself,
      // so start order does not matter.
      "name": "Web HMI: wb_gateway (web server, no machine code)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/wb_gateway.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/install/mingw32-16.2.0/mingw32/bin/gdb.exe",
      "externalConsole": false,
      // Opens the browser HMI as soon as the gateway prints its startup URL.
      // ?src=ws is REQUIRED: web/js/transport/index.js defaults to the MOCK
      // transport, so without it the page shows fake data and looks alive.
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)/",
        "uriFormat": "http://127.0.0.1:%s/?src=ws",
        "action": "openExternally"
      }
    },
    {
      // Data half without the pump: links the god-stack and publishes the tag
      // snapshot on tcp://127.0.0.1:8046, config-derived rather than moving.
      // --dry is NOT optional on a dev machine: LoadMachineConfig() WRITES the
      // shared production system\Gerneral.ini (common.cpp:89); --dry works on a
      // scratch copy.
      "name": "Web HMI: wb_publish --dry (static config feed)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/wb_publish.exe",
      "args": ["--dry"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/install/mingw32-16.2.0/mingw32/bin/gdb.exe",
      "externalConsole": false
    },
    {
      // wb_serve is the SINGLE-PROCESS shape: god-stack + HTTP/WS server in one
      // exe, no loopback hop. It does not pump yet (grep -c Pump tools/wb_serve.cpp
      // = 0), and it calls LoadMachineConfig unconditionally at :90 -- which SEEDS
      // KEYS INTO THE SHARED PRODUCTION system\Gerneral.ini. Left here because it
      // is the shape the architecture doc recommends, but do not run it casually.
      "name": "Web HMI: wb_serve (single process -- WRITES production ini, see comment)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/wb_serve.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/install/mingw32-16.2.0/mingw32/bin/gdb.exe",
      "externalConsole": false
    },
    {
      "name": "Debug one ctest binary (MinGW/gdb)",
      "type": "cppdbg",
      "request": "launch",
      // build_dbg first (it has -g); fall back to build\ if you have not made one.
      "program": "${workspaceFolder}/build/tests/${input:testExe}.exe",
      "args": [],
      "stopAtEntry": false,
      // Several suites read real config/DB files with paths relative to the
      // tree root, so run from there rather than from build/tests.
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/install/mingw32-16.2.0/mingw32/bin/gdb.exe",
      "preLaunchTask": "V906: Build (MinGW, quick)",
      "setupCommands": [
        {
          "description": "Pretty-print STL containers",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "compounds": [
    {
      // THE default F5. Pick it once in the debug dropdown; VS Code remembers.
      //
      // AI(W906-DropMSVC) 20260817: RENAMED from "HT9045: build + state window +
      // web  (THE F5)". The native state window was deleted, so the old name
      // described something that no longer happens -- and the rename also
      // invalidates VS Code's stored selection, which is stored per-workspace
      // where the repo cannot reach it and is the only reason a developer can
      // keep launching a config the repo has already changed. Re-pick once.
      //
      // Two processes now, not three: the publisher drives the spine and serves
      // the tag feed, the gateway serves the browser. Both are MinGW, so ONE
      // preLaunchTask covers both -- which is why the old composite "Build ALL"
      // task is gone too.
      "name": "HT9045: build + Web HMI  (THE F5)",
      "configurations": [
        "Web HMI: wb_publish --pump (live spine feed)",
        "Web HMI: wb_gateway (web server, no machine code)"
      ],
      "preLaunchTask": "V906: Build (MinGW, quick)",
      "stopAll": true,
      "presentation": { "order": 1 }
    }
  ],
  "inputs": [
    {
      "id": "testExe",
      "type": "promptString",
      "description": "ctest binary name, WITHOUT .exe (e.g. test_ga2_c1_cinitial, test_w7_l2_ckernel, test_ga1_lastset)",
      "default": "test_ga2_c1_cinitial"
    }
  ]
}
