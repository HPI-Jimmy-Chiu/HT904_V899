<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HT9045.HardwareAbstraction
    Ports (driving/driven boundary interfaces) for hardware. NO implementation.
    Sim and Real adapters (later projects) implement these. Method names mirror
    the BCB6 C++ classes so the team can reverse-look-up:
      HTMotor      -> IMotorPort
      TLaneIO      -> IIoPort
      KEYPRO_GET_* -> IKeyProPort
      GPIB Tester  -> ITesterInterface
      TempCtrl     -> ITempControlPort
  -->

  <PropertyGroup>
    <RootNamespace>HT9045.HardwareAbstraction</RootNamespace>
    <AssemblyName>HT9045.HardwareAbstraction</AssemblyName>
  </PropertyGroup>

</Project>
