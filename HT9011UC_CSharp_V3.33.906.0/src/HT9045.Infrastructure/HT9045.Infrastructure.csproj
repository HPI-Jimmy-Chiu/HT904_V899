<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HT9045.Infrastructure</RootNamespace>
    <AssemblyName>HT9045.Infrastructure</AssemblyName>
  </PropertyGroup>

  <!--
    Infrastructure has NO ProjectReference to HardwareAbstraction; it is a
    pure infrastructure concern (codec, config, db).  If a future phase needs
    IMotorPort here, add the reference then.
  -->

  <ItemGroup>
    <!--
      Microsoft.Data.Sqlite 8.0.0 — the last version that still targets
      net48 via its netstandard2.0 TFM.  It ships its own native SQLite.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

</Project>
