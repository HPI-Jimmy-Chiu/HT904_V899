<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HT9045.Views.Stub
    Headless stub views for Phase-1 offline smoke runs and unit tests.
    StubMainView implements IMainView: records ShowStatus calls in a public
    List<string> and writes them to Console, so tests can assert without a GUI.
    References Presentation.Abstraction (which already pulls in HardwareAbstraction).
    NO WinForms reference; safe to build with 'dotnet build' on any CI agent.
  -->

  <PropertyGroup>
    <RootNamespace>HT9045.Views.Stub</RootNamespace>
    <AssemblyName>HT9045.Views.Stub</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HT9045.Presentation.Abstraction\HT9045.Presentation.Abstraction.csproj" />
  </ItemGroup>

</Project>
