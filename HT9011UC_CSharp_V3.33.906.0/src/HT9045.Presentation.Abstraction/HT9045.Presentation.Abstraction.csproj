<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HT9045.Presentation.Abstraction
    View contracts (MVP). Stub views (headless, Phase 1) and the real WinForms
    views (Phase 4) both implement these. References HardwareAbstraction so
    presenters can hold ports. NO WinForms here.

    NOTE: it does NOT reference Core. The brief listed Core as a reference here
    AND listed Presentation.Abstraction as a reference from Core, which is a
    project-reference cycle .NET cannot build. Resolution: the dependency runs
    one way only (Core -> Presentation.Abstraction), so the orchestrator in Core
    can drive IMainView. The view contracts use only primitives, so they need no
    Core types. Presenters that need domain types take them as generics / object.
  -->

  <PropertyGroup>
    <RootNamespace>HT9045.Presentation.Abstraction</RootNamespace>
    <AssemblyName>HT9045.Presentation.Abstraction</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HT9045.HardwareAbstraction\HT9045.HardwareAbstraction.csproj" />
  </ItemGroup>

</Project>
