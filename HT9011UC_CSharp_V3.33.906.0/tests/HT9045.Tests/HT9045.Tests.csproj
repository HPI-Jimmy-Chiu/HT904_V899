<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HT9045.Tests
    Phase-1 test suite: Big5 round-trip, offline smoke cycle, architecture guard.
    xUnit 2.5.3 on net48 — no WinForms, no hardware, no native DLL required.
  -->

  <PropertyGroup>
    <RootNamespace>HT9045.Tests</RootNamespace>
    <AssemblyName>HT9045.Tests</AssemblyName>
    <!-- Override Directory.Build.props OutputType default; tests must stay classlib. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
  </ItemGroup>

  <!-- Phase-2 config-load test fixtures: ASCII-only so Big5 decode is a no-op.
       Copied next to the test assembly so ConfigLoadTests can read them by path. -->
  <ItemGroup>
    <Content Include="TestData\Gerneral.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TestData\Mot_Table.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TestData\IO_Table.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HT9045.Core\HT9045.Core.csproj" />
    <ProjectReference Include="..\..\src\HT9045.HardwareAbstraction\HT9045.HardwareAbstraction.csproj" />
    <ProjectReference Include="..\..\src\HT9045.Presentation.Abstraction\HT9045.Presentation.Abstraction.csproj" />
    <ProjectReference Include="..\..\src\HT9045.Hardware.Sim\HT9045.Hardware.Sim.csproj" />
    <ProjectReference Include="..\..\src\HT9045.Views.Stub\HT9045.Views.Stub.csproj" />
    <ProjectReference Include="..\..\src\HT9045.Infrastructure\HT9045.Infrastructure.csproj" />
  </ItemGroup>

</Project>
