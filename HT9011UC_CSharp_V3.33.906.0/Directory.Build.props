<Project>

  <!--
    HT9045 V906 C# migration - common build properties for ALL projects.
    Targets .NET Framework 4.8 with the SDK-style project system so the
    solution builds via 'dotnet build' on a machine WITHOUT Visual Studio.
    The Microsoft.NETFramework.ReferenceAssemblies package supplies the
    net48 reference assemblies that VS would normally provide.

    Do NOT add project-specific PackageReference entries here; keep those
    in the individual .csproj files.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- Keep pre-modern idioms; the team reverse-references the BCB6 source. -->
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- Phase 1 is offline/headless; no platform-specific or unsafe code yet. -->
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets net48 build without Visual Studio (reference assemblies only). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
