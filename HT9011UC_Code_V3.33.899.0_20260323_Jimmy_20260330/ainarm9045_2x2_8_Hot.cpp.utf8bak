        Spacing=1;
        Step=4;
    }

    for(i=0; i<Step; i++)
    {
        if(iPick8IC!=0x03)
            iSX=iPickX+i*(HotPlateForm.XDivision/2);
        else
            iSX=iPickX+i*(HotPlateForm.XDivision/4);

        if(Row2Only)
            Chanel=1;
