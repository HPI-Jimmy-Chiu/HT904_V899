{
  // ==========================================================================
  //  HT9045 multi-root workspace. AI(W906-GateA-vscode) 20260804.
  //
  //  WHY THIS FILE EXISTS -- it is not cosmetic. The two trees have DIFFERENT
  //  source encodings:
  //
  //    D:\HT9045                       (BCB6 golden, V899, config)  = Big5
  //    HT9011UC_Cpp_V3.33.906.0        (the C++ port)               = UTF-8
  //
  //  A single-root window can only hold one "files.encoding". Whichever one it
  //  is, half the tree opens as mojibake -- and SAVING re-encodes the file,
  //  which silently corrupts Chinese comments. Multi-root fixes it: each
  //  folder keeps its own .vscode/settings.json, so encoding follows the file.
  //
  //  OPEN THIS FILE (File > Open Workspace from File...) rather than opening
  //  D:\HT9045 as a plain folder.
  //
  //  If you only ever work on the port, opening HT9011UC_Cpp_V3.33.906.0
  //  directly is equally safe -- its folder settings pin UTF-8 on their own.
  // ==========================================================================
  "folders": [
    {
      "name": "HT9045 (root: BCB6 golden / V899 / config -- Big5)",
      "path": "."
    },
    {
      "name": "V906 C++ port (UTF-8)",
      "path": "HT9011UC_Cpp_V3.33.906.0"
    }
  ],
  "settings": {
    // Workspace-level fallback only. The real encoding decision lives in each
    // folder's .vscode/settings.json -- root = big5, port = utf8 -- and folder
    // settings win for files inside that folder.
    "files.autoGuessEncoding": true,
    "search.useIgnoreFiles": true,
    // The port tree is listed as its own folder above, so exclude it from the
    // root folder's view to avoid every file appearing twice in search results.
    "search.exclude": {
      "HT9011UC_Cpp_V3.33.906.0": true,
      "**/.svn": true,
      "**/Obj": true,
      "**/EXE": true
    }
  },
  // ==========================================================================
  //  AI(W906-StateWin) 20260814: WORKSPACE-LEVEL F5.
  //
  //  WHY THIS SECTION HAD TO BE ADDED. Every launch configuration in this repo
  //  lived in HT9011UC_Cpp_V3.33.906.0/.vscode/launch.json, i.e. in ONE of the two
  //  folders. In a multi-root window, F5 acts on whatever the debug dropdown has
  //  selected, and that selection is stored in VS Code's per-workspace state --
  //  which no file in this repository can reach. The observed consequence was
  //  exactly the confusing one: the compound could be rewired, and pressing F5
  //  still launched whatever had been picked months earlier.
  //
  //  A workspace-level compound is the fix, because it is listed regardless of
  //  which folder has focus, and it appears above the folder-scoped entries. The
  //  folder's own launch.json keeps the individual pieces; this only names the
  //  one-keypress combination, so there is a single definition of each piece.
  // ==========================================================================
  // ==========================================================================
  //  AI(W906-WsTask) 20260817: WORKSPACE-LEVEL TASKS -- and why this had to exist.
  //
  //  The compound below names a preLaunchTask. A workspace-level launch entry has
  //  no owning folder, so VS Code resolves preLaunchTask against WORKSPACE-level
  //  tasks -- and this file declared none, while the label it named
  //  ("V906: Build (MinGW, quick)") lives in the PORT FOLDER's .vscode/tasks.json.
  //  The previous comment on that line even said "the task is folder-scoped, so it
  //  is named as folder + task", but the value was just the bare task name: the
  //  original author spotted the mismatch and it was never resolved.
  //
  //  Declaring it here makes the workspace F5 self-contained. ${workspaceFolder:...}
  //  is indexed by the FOLDER NAME as declared in "folders" above, so this string
  //  and that name must stay in sync -- if you rename the folder entry, rename it
  //  here too.
  //
  //  The port folder's own tasks.json is UNCHANGED, so Ctrl+Shift+B from inside
  //  that folder still runs its copy. Two declarations of the same one-line
  //  delegation to build.bat is the cost of multi-root; duplicating build LOGIC
  //  would not be acceptable, duplicating a delegation is.
  // ==========================================================================
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "V906: Build (MinGW, quick) [workspace]",
        "detail": "Workspace-level copy so the F5 compound below can resolve it. Delegates to build.bat, same as the folder task.",
        "type": "shell",
        "command": "${workspaceFolder:V906 C++ port (UTF-8)}\\build.bat",
        "options": {
          "cwd": "${workspaceFolder:V906 C++ port (UTF-8)}",
          // cmd.exe, not PowerShell: build.bat documents that requirement, and
          // PowerShell will not resolve a bare batch name from the cwd anyway.
          "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
        },
        "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
        // g++ emits absolute paths, so anchor the matcher to them.
        "problemMatcher": {
          "owner": "cpp",
          "fileLocation": "absolute",
          "pattern": {
            "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|note|fatal error):\\s+(.*)$",
            "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
          }
        }
      }
    ]
  },

  "launch": {
    "version": "0.2.0",
    "configurations": [],
    "compounds": [
      {
        // The three things one keypress is supposed to deliver:
        // AI(W906-DropMSVC) 20260817: two legs now, not three -- the native MFC
        // window was deleted with MSVC, and both survivors are MinGW so one
        // preLaunchTask covers them.
        //   1. the C++ core compiles   (preLaunchTask, MinGW)
        //   2. the web view opens      (gateway + serverReadyAction, ?src=ws)
        "name": "HT9045: build + Web HMI  (THE F5)",
        "configurations": [
          { "folder": "V906 C++ port (UTF-8)", "name": "Web HMI: wb_publish --pump (live spine feed)" },
          { "folder": "V906 C++ port (UTF-8)", "name": "Web HMI: wb_gateway (web server, no machine code)" }
        ],
        //AI(W906-WsTask) 20260817: points at the WORKSPACE-level task declared
        // above, not the port folder's. A workspace launch entry cannot resolve a
        // folder-scoped task label -- that was the latent defect here.
        "preLaunchTask": "V906: Build (MinGW, quick) [workspace]",
        "stopAll": true,
        "presentation": { "order": 1 }
      }
    ]
  },

  "extensions": {
    "recommendations": [
      "ms-vscode.cpptools-extension-pack"
    ]
  }
}
