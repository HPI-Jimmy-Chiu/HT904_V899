{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "pwsh -File ./scripts/ops/check-write-boundary.ps1",
        "windows": "powershell -ExecutionPolicy Bypass -File .\\scripts\\ops\\check-write-boundary.ps1",
        "env": {
          "OPS_WRITE_POLICY": ".github/ops/write-boundary-policy.json"
        },
        "timeout": 10
      }
    ]
  }
}
